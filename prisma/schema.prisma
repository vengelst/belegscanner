generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum Role {
  ADMIN
  USER
}

enum SendStatus {
  OPEN
  READY
  SENT
  FAILED
  RETRY
}

enum ReviewStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  DEFERRED
  COMPLETED
}

enum DocumentType {
  GENERAL
  FUEL
  HOSPITALITY
  LODGING
  PARKING
  TOLL
}

enum FileType {
  ORIGINAL
  PRINT_PDF
}

enum PartyRole {
  CREDITOR
  DEBTOR
}

// DATEV-Belegtyp. Steuert beim Upload-Mail-Versand die Zieladresse:
// DATEV bestimmt den Belegtyp ueber die Empfaengeradresse, nicht ueber den Inhalt.
enum DatevBelegtyp {
  RECHNUNGSEINGANG
  RECHNUNGSAUSGANG
  KASSE
  KREDITKARTENBELEGE
  SONSTIGE
  REISEKOSTEN
}

// ============================================================
// Stammdaten
// ============================================================

model Vehicle {
  id                   String    @id @default(cuid())
  plate                String    @unique
  description          String?
  active               Boolean   @default(true)
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  receipts             Receipt[]
  usersWithDefault     User[]    @relation("userDefaultVehicle")

  @@index([active, sortOrder])
}

model Purpose {
  id                 String    @id @default(cuid())
  name               String    @unique
  isHospitality      Boolean   @default(false)
  active             Boolean   @default(true)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  receipts           Receipt[]
  usersWithDefault   User[]    @relation("userDefaultPurpose")

  @@index([active, sortOrder])
}

model Category {
  id                 String    @id @default(cuid())
  name               String    @unique
  active             Boolean   @default(true)
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  receipts           Receipt[]
  usersWithDefault   User[]    @relation("userDefaultCategory")

  @@index([active, sortOrder])
}

model Country {
  id                   String    @id @default(cuid())
  code                 String?   @unique
  name                 String
  currencyCode         String?   @db.VarChar(3)
  vatRatePercent       Decimal?  @db.Decimal(5, 2)
  active               Boolean   @default(true)
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  receipts             Receipt[]
  usersWithDefault     User[]    @relation("userDefaultCountry")

  @@index([active, sortOrder])
}

// ============================================================
// Benutzerverwaltung (Systemdaten)
// ============================================================

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String
  passwordHash      String
  pinHash           String?
  role                     Role       @default(USER)
  active                   Boolean    @default(true)
  canSendWithoutApproval   Boolean    @default(false)
  failedPinAttempts        Int        @default(0)
  pinLockedUntil    DateTime?
  lastLoginAt       DateTime?
  defaultCountryId  String?
  defaultCountry    Country?   @relation("userDefaultCountry", fields: [defaultCountryId], references: [id], onDelete: SetNull)
  defaultVehicleId  String?
  defaultVehicle    Vehicle?   @relation("userDefaultVehicle", fields: [defaultVehicleId], references: [id], onDelete: SetNull)
  defaultPurposeId  String?
  defaultPurpose    Purpose?   @relation("userDefaultPurpose", fields: [defaultPurposeId], references: [id], onDelete: SetNull)
  defaultCategoryId String?
  defaultCategory   Category?  @relation("userDefaultCategory", fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  uiTemplate        String     @default("classic")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  receipts          Receipt[]
  reviewedReceipts  Receipt[]        @relation("reviewer")
  comments          ReceiptComment[]
  auditLogs         AuditLog[]
  backups           Backup[]
  restoreLogs       RestoreLog[]

  @@index([email])
  @@index([active])
  @@index([defaultCountryId])
  @@index([defaultVehicleId])
  @@index([defaultPurposeId])
  @@index([defaultCategoryId])
}

// ============================================================
// Bewegungsdaten
// ============================================================

model Receipt {
  id                  String     @id @default(cuid())

  // Benutzer
  userId              String
  user                User       @relation(fields: [userId], references: [id])

  // Belegdaten
  date                DateTime   @db.Date
  partyRole           PartyRole  @default(CREDITOR)
  supplier            String?
  invoiceNumber       String?    @db.VarChar(80)
  serviceDate         DateTime?  @db.Date
  dueDate             DateTime?  @db.Date

  // Betrag und Waehrung
  amount              Decimal    @db.Decimal(12, 2)
  currency            String     @default("EUR") @db.VarChar(3)
  netAmount           Decimal?   @db.Decimal(12, 2)
  taxAmount           Decimal?   @db.Decimal(12, 2)
  reverseCharge       Boolean    @default(false)
  vatRatePercent      Decimal?   @db.Decimal(5, 2)
  exchangeRate        Decimal?   @db.Decimal(18, 8)
  exchangeRateDate    DateTime?  @db.Date
  amountEur           Decimal    @db.Decimal(12, 2)

  // Zuordnungen (Stammdaten-Referenzen)
  countryId           String?
  country             Country?   @relation(fields: [countryId], references: [id])
  vehicleId           String?
  vehicle             Vehicle?   @relation(fields: [vehicleId], references: [id])
  purposeId           String
  purpose             Purpose    @relation(fields: [purposeId], references: [id])
  categoryId          String
  category            Category   @relation(fields: [categoryId], references: [id])

  // DATEV-Profil
  datevProfileId      String?
  datevProfile        DatevProfile? @relation(fields: [datevProfileId], references: [id])

  // DATEV-Belegtyp (Pflicht vor Versand; bestimmt die Upload-Mail-Zieladresse)
  datevBelegtyp       DatevBelegtyp?

  // Versandstatus (technisch: SMTP-Ergebnis)
  sendStatus          SendStatus @default(OPEN)
  sendStatusUpdatedAt DateTime?

  // Pruef-/Freigabestatus (fachlich: Buchhaltungs-Workflow)
  reviewStatus        ReviewStatus @default(DRAFT)
  reviewedById        String?
  reviewedBy          User?        @relation("reviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?

  // Freitext
  remark              String?    @db.Text

  // KI-Rohdaten
  aiRawText           String?       @map("ocrRawText") @db.Text
  aiDocumentType      DocumentType? @map("detectedDocumentType")
  aiStructuredData    Json?         @map("ocrStructuredData")

  // Relationen
  hospitality         Hospitality?
  files               ReceiptFile[]
  sendLogs            SendLog[]
  comments            ReceiptComment[]

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  @@index([userId])
  @@index([sendStatus])
  @@index([reviewStatus])
  @@index([date])
  @@index([purposeId])
  @@index([categoryId])
  @@index([countryId])
  @@index([datevProfileId])
  @@index([datevBelegtyp])
  @@index([aiDocumentType], map: "Receipt_detectedDocumentType_idx")
  @@index([createdAt])
  @@index([invoiceNumber])
  @@index([serviceDate])
  @@index([dueDate])
  @@index([deletedAt])
}

// Bewirtungsdetails (1:1-Erweiterung, nur bei Zweck = Bewirtung)
model Hospitality {
  id        String   @id @default(cuid())
  receiptId String   @unique
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  occasion  String
  guests    String   @db.Text
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Interne Kommentare / Pruefnotizen am Beleg
model ReceiptComment {
  id        String   @id @default(cuid())
  receiptId String
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([receiptId, createdAt])
}

// ============================================================
// Dateien
// ============================================================

model ReceiptFile {
  id          String   @id @default(cuid())
  receiptId   String
  receipt     Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  type        FileType
  mimeType    String
  filename    String
  storagePath String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([receiptId, type])
}

// ============================================================
// Systemdaten
// ============================================================

// SMTP-Konfiguration (Singleton-Zeile)
model SmtpConfig {
  id                String   @id @default("default")
  host              String
  port              Int      @default(587)
  secure            Boolean  @default(true)
  username          String
  passwordEncrypted String
  fromAddress       String
  replyToAddress    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// DATEV-Versandprofil
model DatevProfile {
  id                String    @id @default(cuid())
  name              String    @unique
  // Standard-/Fallback-Adresse (entspricht fachlich dem Belegtyp Rechnungseingang)
  datevAddress      String
  senderAddress     String
  subjectTemplate   String?
  bodyTemplate      String?   @db.Text
  isDefault         Boolean   @default(false)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  receipts          Receipt[]
  belegtypAddresses DatevBelegtypAddress[]

  @@index([active, isDefault])
}

// DATEV-Upload-Mail-Adresse je Belegtyp (aus DATEV Unternehmen online uebernommen)
model DatevBelegtypAddress {
  id           String        @id @default(cuid())
  profileId    String
  profile      DatevProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  belegtyp     DatevBelegtyp
  datevAddress String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([profileId, belegtyp])
  @@index([profileId])
}

// Versandprotokoll
model SendLog {
  id           String   @id @default(cuid())
  receiptId    String
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  sentAt       DateTime @default(now())
  toAddress    String
  success      Boolean
  errorMessage String?  @db.Text
  messageId    String?
  createdAt    DateTime @default(now())

  @@index([receiptId])
  @@index([success])
  @@index([createdAt])
}

// Audit-Log
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ============================================================
// Backup-System
// ============================================================

// Eigene Firma / Organisation (Singleton-Zeile fuer KI Debitoren-Erkennung)
model OrganizationProfile {
  id          String   @id @default("default")
  legalName   String   @default("")
  tradeName   String?
  vatId       String?
  street      String?
  zip         String?
  city        String?
  countryCode String?
  // Endziffern der Firmenkarten (2-4 Ziffern, nie vollstaendige Kartennummern).
  // Trifft eine per OCR erkannte Kartenendung zu, wird der Beleg als
  // Kreditkartenbeleg eingestuft, sonst als Kasse (privat verauslagt).
  companyCardLastDigits String[] @default([])
  // Belegtyp, mit dem jeder neue Beleg startet, solange die Belegerkennung
  // nichts Belastbares liefert.
  defaultDatevBelegtyp DatevBelegtyp @default(RECHNUNGSEINGANG)
  // Eigene Bezeichnungen je Belegtyp: Record<DatevBelegtyp, string>, nur
  // abweichende Eintraege. Fehlt ein Eintrag, gilt der DATEV-Standardname.
  datevBelegtypLabelOverrides Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Dashboard-Layout (Singleton-Zeile, shared fuer alle User)
model DashboardConfig {
  id        String   @id @default("default")
  widgets   Json     @default("[]")
  updatedAt DateTime @updatedAt
}

// KI-Konfiguration (Singleton-Zeile)
model AiConfig {
  id            String   @id @default("singleton")
  provider      String   @default("openai")  // openai, anthropic, google
  model         String   @default("gpt-4o-mini")
  apiKeyEnc     String?  // verschluesselt wie SMTP
  baseUrl       String?  // Optional fuer custom endpoints
  ocrServiceUrl String?  @default("http://ocr-service:8000")
  updatedAt     DateTime @updatedAt
}

// Backup-Konfiguration (Singleton-Zeile)
model BackupConfig {
  id                String   @id @default("singleton")
  storageType       String   @default("local") // "local" | "s3"
  localPath         String   @default("/app/storage/backups")
  s3Endpoint        String?
  s3Bucket          String?
  s3AccessKey       String?
  s3SecretKeyEnc    String?  // verschluesselt wie SMTP-Passwort
  s3Region          String?
  scheduleEnabled   Boolean  @default(false)
  scheduleCron      String   @default("0 2 * * *") // taeglich 2:00
  retentionDays     Int      @default(30)
  updatedAt         DateTime @updatedAt
}

// Backup-Eintraege
model Backup {
  id            String       @id @default(cuid())
  type          String       // "full" | "database" | "files"
  status        String       // "pending" | "running" | "completed" | "failed"
  fileName      String?
  fileSize      Int?
  dbRecords     Int?
  filesCount    Int?
  errorMessage  String?      @db.Text
  triggeredBy   String       // "manual" | "scheduled"
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  restoreLogs   RestoreLog[]

  @@index([status])
  @@index([startedAt])
  @@index([userId])
}

// Wiederherstellungs-Protokoll
model RestoreLog {
  id            String    @id @default(cuid())
  backupId      String
  backup        Backup    @relation(fields: [backupId], references: [id], onDelete: Cascade)
  status        String    // "pending" | "running" | "completed" | "failed"
  errorMessage  String?   @db.Text
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([backupId])
  @@index([userId])
}

